import type { ParsedSchema } from '@yiyuan/core'
import { getPrimaryKey } from '@yiyuan/core'

export function generateHandler(schema: ParsedSchema, modelName: string): string {
  const model = schema.models[modelName]
  const pk = getPrimaryKey(model) ?? 'id'
  const lower = modelName.toLowerCase()
  const plural = lower + 's'

  return `// ─── 一元 自动生成 ───
import { Hono } from 'hono'
import { getDB } from '@yiyuan/server'
import { printDBCreate, printDBRead, printDBUpdate, printDBDelete } from '@yiyuan/server'

const app = new Hono()

app.get('/api/${plural}', async (c) => {
  const where = c.req.query('where')
  const limit = c.req.query('limit')
  const orderBy = c.req.query('orderBy')
  const offset = c.req.query('offset')

  const results = await getDB().findMany('${modelName}', {
    where: where ? JSON.parse(where) : undefined,
    limit: limit ? Number(limit) : undefined,
    orderBy: orderBy ? JSON.parse(orderBy) : undefined,
    offset: offset ? Number(offset) : undefined,
  })

  printDBRead('${modelName}', results.length, results)
  return c.json(results)
})

app.get('/api/${plural}/:id', async (c) => {
  const result = await getDB().findOne('${modelName}', { ${pk}: c.req.param('id') })
  if (!result) return c.json({ error: 'Not found' }, 404)
  printDBRead('${modelName}', 1, [result])
  return c.json(result)
})

app.post('/api/${plural}', async (c) => {
  const body = await c.req.json()
  const result = await getDB().create('${modelName}', body)
  printDBCreate('${modelName}', result)
  return c.json(result, 201)
})

app.patch('/api/${plural}', async (c) => {
  const { id, ...data } = await c.req.json()
  const result = await getDB().update('${modelName}', { ${pk}: id }, data)
  printDBUpdate('${modelName}', id, data)
  return c.json(result)
})

app.delete('/api/${plural}', async (c) => {
  const { id } = await c.req.json()
  await getDB().delete('${modelName}', { ${pk}: id })
  printDBDelete('${modelName}', id)
  return c.json({ ok: true })
})

export const ${lower}Routes = app
`
}
